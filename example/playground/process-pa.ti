#SECTION Prolog

DatasourceNameForServer=pDimensionName;

#SECTION Metadata

IF ( ElementType( pDimensionName, pHierarchyName, vElementName) @= pElementType  );
DimensionElementDelete( pDimensionName, vElementName );
EndIf;

#SECTION Data

#SECTION Epilog

#JSON_PROPERTIES
{
  "Parameters": [
    {
      "Name": "pDimensionName",
      "Prompt": "Dimension Name",
      "Value": "TestDimension",
      "Type": "String"
    },
    {
      "Name": "pHierarchyName",
      "Prompt": "Hierarchy Name",
      "Value": "TestHierarchy",
      "Type": "String"
    },
    {
      "Name": "pElementType",
      "Prompt": "( C | N | S ) Only elements of type",
      "Value": "C",
      "Type": "String"
    }
  ],
  "DataSource": {
    "Type": "TM1DimensionSubset",
    "dataSourceNameForClient": "TestDimension:TestHierarchy",
    "dataSourceNameForServer": "TestDimension:TestHierarchy",
    "subset": "All"
  },
  "Variables": [
    {
      "Name": "vElementName",
      "Type": "String",
      "Position": 1,
      "StartByte": 0,
      "EndByte": 0
    }
  ],
  "HasSecurityAccess": false
}